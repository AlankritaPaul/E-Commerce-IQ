# ==============================================================================
# E-Commerce IQ - Environment Configuration Template
# Copy this file to .env and fill in your configuration values.
# DO NOT commit .env to source control.
# ==============================================================================

# Application Settings
APP_NAME="E-Commerce IQ"
APP_ENV="development"
DEBUG=True
LOG_LEVEL="INFO"

# Database Configuration
# Default is a local SQLite database stored in the data directory.
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/ecommerce_iq
DATABASE_URL="sqlite:///data/ecommerce_iq.db"

# AI / Large Language Model Configuration
# Primary recommended provider is Google Gemini
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.0-flash"

# Optional: Alternative LLM providers
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Streamlit UI Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS="localhost"
